# Optional: JARVIS als systemd-User-Dienst statt Desktop-Autostart.
# ACHTUNG: Ein Dienst außerhalb der Desktop-Sitzung kann keinen pkexec-Dialog anzeigen.
# Setze daher in ~/.config/jarvis/config.yaml  tools.privilege_cmd: sudo
# und lege eine sudoers-Regel an (siehe README, Abschnitt „Root-Rechte“).
#
#   cp scripts/jarvis.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now jarvis
[Unit]
Description=JARVIS lokaler KI-Assistent
After=network-online.target ollama.service

[Service]
ExecStart=%h/.local/bin/jarvis serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
