#!/usr/bin/env bash
# Starts Orbwise (if needed) and opens the web UI in its own app window.
PORT="${ORBWISE_PORT:-8765}"
URL="http://localhost:$PORT"

if ! curl -fs "$URL/api/status" >/dev/null 2>&1; then
  mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}"
  nohup "$HOME/.local/bin/orbwise" serve >"${XDG_STATE_HOME:-$HOME/.local/state}/orbwise.log" 2>&1 &
  for _ in $(seq 1 60); do
    curl -fs "$URL/api/status" >/dev/null 2>&1 && break
    sleep 0.5
  done
fi

for browser in chromium google-chrome-stable google-chrome brave vivaldi-stable microsoft-edge-stable; do
  if command -v "$browser" >/dev/null; then
    exec "$browser" --app="$URL" --class=orbwise
  fi
done
exec xdg-open "$URL"
