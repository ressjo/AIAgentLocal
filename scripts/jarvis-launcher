#!/usr/bin/env bash
# JARVIS launcher (installed to ~/.local/bin/jarvis by scripts/install.sh).
# Self-healing: if the Python environment is missing (e.g. after a fresh download) it is recreated.
JARVIS_HOME="${JARVIS_HOME:-@JARVIS_HOME@}"

if [ ! -f "$JARVIS_HOME/pyproject.toml" ]; then
  echo "JARVIS was not found in '$JARVIS_HOME'." >&2
  echo "Reinstall:  git clone -b @JARVIS_BRANCH@ @JARVIS_REPO@ ~/jarvis && ~/jarvis/scripts/install.sh" >&2
  exit 1
fi

if [ ! -x "$JARVIS_HOME/.venv/bin/jarvis" ]; then
  if ! command -v uv >/dev/null 2>&1; then
    echo "uv is missing – please run '$JARVIS_HOME/scripts/install.sh'." >&2
    exit 1
  fi
  echo "Python environment missing – recreating it (one-off, takes a moment) …" >&2
  (cd "$JARVIS_HOME" && uv sync --extra voice --quiet) || exit 1
fi

exec "$JARVIS_HOME/.venv/bin/jarvis" "$@"
