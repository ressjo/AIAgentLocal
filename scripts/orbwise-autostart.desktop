[Desktop Entry]
Type=Application
Name=Orbwise (background service)
Comment=Starts the Orbwise server at login
Exec=sh -c 'mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}" && exec @HOME@/.local/bin/orbwise serve >"${XDG_STATE_HOME:-$HOME/.local/state}/orbwise.log" 2>&1'
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
