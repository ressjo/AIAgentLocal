# Optional: run JARVIS as a systemd user service instead of the desktop autostart.
# Root actions keep working through the password field in the dashboard (tools.privilege_cmd: jarvis).
# Opening files/apps on your desktop works best when JARVIS runs inside the desktop session (autostart).
#
#   cp scripts/jarvis.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now jarvis
[Unit]
Description=JARVIS local AI assistant
After=network-online.target ollama.service

[Service]
ExecStart=%h/.local/bin/jarvis serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
